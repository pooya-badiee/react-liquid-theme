{
  "name": "react-liquid-theme",
  "description": "A tool for generating shopify .liquid theme files from React components.",
  "keywords": [
    "react",
    "liquid",
    "theme",
    "shopify"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pooya-badiee/react-liquid-theme.git"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "version": "0.12.0",
  "scripts": {
    "format": "biome format",
    "lint": "biome lint",
    "format:fix": "biome format --write",
    "lint:fix": "biome lint --unsafe --write",
    "fix": "biome check --unsafe --fix",
    "build": "rolldown -c rolldown.config.mjs && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test",
    "create-test-project": "node scripts/create-test-project.js"
  },
  "bin": {
    "react-liquid-theme": "dist/cli.js"
  },
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./declarations": {
      "types": "./dist/declarations.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "types": "./dist/utils.d.ts"
    },
    "./config": {
      "import": "./dist/config.js",
      "types": "./dist/config.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "declarations": [
        "./dist/declarations.d.ts"
      ]
    }
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.15",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yargs": "^17",
    "react": "^19",
    "react-dom": "^19",
    "sass": "^1",
    "typescript": "~6.0.3",
    "vitest": "^3"
  },
  "dependencies": {
    "@shopify/prettier-plugin-liquid": "^1",
    "chalk": "^4",
    "chokidar": "^4",
    "dedent": "^1",
    "dotenv": "^16",
    "glob": "^11",
    "html-entities": "^2",
    "html-react-parser": "^5",
    "postcss": "^8",
    "postcss-modules": "^6",
    "prettier": "^3",
    "rolldown": "^1.2.13",
    "yargs": "^17",
    "zod": ">=3.25.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "sass": ">=1",
    "typescript": ">=5.8 <7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@11.1.2"
}
